[user]
    name =
    email =
[core]
    excludesfile = /home/__USERNAME__/.gitignore
    editor = vim
[alias]
    co = commit
    ch = checkout
    st = status
    br = branch -vv
    amend = commit --amend
    continue = rebase --continue
    unstage = reset HEAD --
    ls = log -n 54 --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
    synctag = "!git tag -l | xargs git tag -d && git fetch origin --tags"
 #   fixup = commit --fixup
    brv = for-each-ref --sort=-committerdate --format=\"%(if)%(HEAD)%(then)%(color:bold green)*%(else) %(end)%(color:yellow)%(align:40,left)%(refname:short)%(end)%(color:reset) %(color:cyan)%(align:25,left)%(committerdate:relative)%(end)%(color:reset) %(color:blue)%(align:25,left)%(authorname)%(end)%(color:reset) %(subject)\" refs/heads/
#[init]
#    defaultBranch = main
[color "branch"]
    upstream = cyan
[pager]
    branch = false
    log = false
[push]
    autoSetupRemote = true
[init]
    defaultBranch = master
